# Copy to ops/local.env (untracked) and fill in. Sourced by deploy.sh and
# backup.sh, and by the cron wrapper before it calls notify.py.
LAMINAR_HOST=root@203.0.113.10          # user@host of the collector box
LAMINAR_SSH_KEY=~/.ssh/id_ed25519       # key that reaches it
LAMINAR_MAILHOST=203.0.113.25           # MX that accepts mail for MAIL_TO
LAMINAR_MAIL_FROM=alerts@example.invalid
LAMINAR_MAIL_TO=you@example.invalid
export LAMINAR_MAILHOST LAMINAR_MAIL_FROM LAMINAR_MAIL_TO
